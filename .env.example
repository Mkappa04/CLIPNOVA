# CLIPNOVA configuration — copy to .env (install.sh does it). Never commit .env.
# Bind address: keep on localhost. Public binding is refused unless explicitly allowed.
CLIPNOVA_HOST=127.0.0.1
CLIPNOVA_PORT=8000

# Data folder (videos, thumbnails, database, logs, renders). Relative paths are from the project root.
CLIPNOVA_DATA_DIR=data
CLIPNOVA_LOG_LEVEL=INFO

# Upload limit in MB (prefer "import from path" for very large recordings)
CLIPNOVA_MAX_UPLOAD_MB=20480

# Parallel jobs. Keep 1 on a 6 GB GPU / 8 GB RAM machine.
CLIPNOVA_WORKER_CONCURRENCY=1

# GPU usage (NVENC rendering, CUDA for AI from Milestone 2) and VRAM budget for AI models
CLIPNOVA_USE_GPU=true
CLIPNOVA_MAX_VRAM_MB=4500

CLIPNOVA_DEFAULT_LANGUAGE=it

# Transcription (faster-whisper). GPU model used when >= MIN_FREE_VRAM MB are free, else CPU model.
# large-v3-turbo int8_float16 uses ~1.5 GB VRAM on the RTX 3060. Smaller: medium, small, base.
CLIPNOVA_WHISPER_MODEL=large-v3-turbo
CLIPNOVA_WHISPER_CPU_MODEL=small
CLIPNOVA_WHISPER_MIN_FREE_VRAM_MB=2000
# false = run Whisper in a child process per job: RAM/VRAM fully released afterwards (recommended)
CLIPNOVA_WHISPER_KEEP_LOADED=false

# Video decoder for analysis: cpu (faster on i5-11400H) or nvdec (frees the CPU). The other is the fallback.
CLIPNOVA_ANALYSIS_DECODER=cpu

# Social publishing stays disabled; every publication requires approval + explicit confirmation.
CLIPNOVA_PUBLISHING_ENABLED=false

# Content generation: "none" = templates only (no LLM); "ollama" = optional local LLM via Ollama
CLIPNOVA_LLM_PROVIDER=none
CLIPNOVA_LLM_MODEL=qwen3.5:4b
CLIPNOVA_LLM_URL=http://127.0.0.1:11434
# Semantic clip detection (story/joke/payoff understanding) with the local LLM: auto | off
CLIPNOVA_SEMANTIC_SCORING=auto
CLIPNOVA_SEMANTIC_MODEL=qwen3:8b
# The AI Editing Planner uses the same local model (per clip: Clip Editor → "AI locale + regole" / "Solo regole")
# Brand Kit: max logo size (MB) and max side (px)
CLIPNOVA_BRAND_LOGO_MAX_MB=5
CLIPNOVA_BRAND_LOGO_MAX_PX=4096
# Embedding model that learns your taste from approved/rejected clips
CLIPNOVA_PREFERENCE_EMBED_MODEL=embeddinggemma

# Optional: also copy every export package here, e.g. a Windows folder for uploading from the browser
# CLIPNOVA_EXPORT_COPY_DIR=/mnt/c/Users/<you>/Videos/CLIPNOVA

# Optional: Fernet key for encrypting platform tokens (default: data/secret.key, created with 0600)
# CLIPNOVA_SECRET_KEY=

# Automation (watch folders): polling interval, stability wait, OBS .mkv remux grace (seconds)
CLIPNOVA_AUTOMATION_ENABLED=true
CLIPNOVA_AUTOMATION_POLL_S=15
CLIPNOVA_AUTOMATION_STABLE_S=10
CLIPNOVA_AUTOMATION_REMUX_GRACE_S=60

# Discovery (official APIs, search only). Keys are entered in Settings and stored encrypted.
CLIPNOVA_DISCOVERY_CACHE_TTL_H=6
CLIPNOVA_YOUTUBE_DAILY_QUOTA=10000
CLIPNOVA_TWITCH_GAME_NAME=Grand Theft Auto VI
