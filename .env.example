# CLIPNOVA configuration — copy to .env (install.sh does it). Never commit .env.
# Bind address: keep on localhost. Public binding is refused unless explicitly allowed.
CLIPNOVA_HOST=127.0.0.1
CLIPNOVA_PORT=8000

# Data folder (videos, thumbnails, database, logs, renders). Relative paths are from the project root.
CLIPNOVA_DATA_DIR=data
CLIPNOVA_LOG_LEVEL=INFO

# Upload limit in MB (prefer "import from path" for very large recordings)
CLIPNOVA_MAX_UPLOAD_MB=20480

# Parallel jobs. Keep 1 on a 6 GB GPU / 8 GB RAM machine.
CLIPNOVA_WORKER_CONCURRENCY=1

# GPU usage (NVENC rendering, CUDA for AI from Milestone 2) and VRAM budget for AI models
CLIPNOVA_USE_GPU=true
CLIPNOVA_MAX_VRAM_MB=4500

CLIPNOVA_DEFAULT_LANGUAGE=it

# Social publishing stays disabled; every publication will require explicit approval.
CLIPNOVA_PUBLISHING_ENABLED=false
